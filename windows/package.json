{
  "name": "macha-windows",
  "private": true,
  "version": "0.1.15",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "preview": "vite preview",
    "icons": "node scripts/gen-icons.mjs",
    "tauri": "node scripts/tauri.mjs",
    "predev": "cargo build --release -p macha-hook",
    "prebuild": "cargo build --release -p macha-hook",
    "pack": "node scripts/tauri.mjs build && node scripts/pack.mjs",
    "pack:msix": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pack-msix.ps1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/markdown-it": "^14.2.0",
    "typescript": "^5.6.0",
    "vite": "^6"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "dompurify": "^3.4.17",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "markdown-it-texmath": "^1.0.0"
  }
}
