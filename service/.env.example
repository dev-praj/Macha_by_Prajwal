PORT=8788
MACHA_REGISTRY_TOKEN=generate-a-random-value-and-store-in-host-secrets
MACHA_PROXY_KEY=generate-a-random-value-and-store-in-host-secrets
MACHA_AI_MAX_CONCURRENT_PER_USER=1
MACHA_AI_REQUESTS_PER_HOUR=20
MACHA_AI_REQUESTS_PER_DAY=200
MACHA_AI_MAX_CONCURRENT=4
MACHA_AI_MAX_QUEUE=16
MACHA_AI_QUEUE_WAIT_MS=60000
MACHA_AI_MAX_OUTPUT_TOKENS=4096
MACHA_AI_MAX_REQUEST_BYTES=1048576
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-project-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
GITHUB_OAUTH_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_OAUTH_CLIENT_SECRET=your-github-oauth-app-client-secret
# Inject these from the host secret manager. Keep old key IDs available during rotation.
COPILOT_ENCRYPTION_KEY_ID=2026-01
COPILOT_ENCRYPTION_KEYS={"2026-01":"base64-encoded-32-byte-key"}
